# Django backend (source of truth for persons, cameras and detections)
DJANGO_BASE_URL=http://localhost:8000
# Must equal server/backend/.env
AI_ENGINE_API_KEY=change-me-same-as-django
JWT_SECRET=change-me-same-as-django

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# auto | cpu | cuda  (cuda requires onnxruntime-gpu instead of onnxruntime)
AI_DEVICE=auto
FACE_MATCH_THRESHOLD=0.40
FACE_REPORT_THRESHOLD=0.45

QDRANT_HOST=localhost
QDRANT_PORT=6333

# Photos are only downloaded from the TAMBUA media bucket
PHOTO_URL_ALLOWED_PREFIXES=http://localhost:9000/tambua-media/,http://127.0.0.1:9000/tambua-media/

# Optional OBS/DroidCam discovery
OBS_ENABLED=true
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
